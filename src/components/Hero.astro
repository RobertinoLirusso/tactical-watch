---
// Hero.astro - Original Centered Tactical Expedition Clock
---

<section aria-label="Primary Digital Clock" class="w-full max-w-5xl mx-auto flex flex-col items-center justify-center text-center my-2 sm:my-4">
  <h1 class="text-[10px] sm:text-xs font-mono-numbers tracking-[0.35em] text-neutral-500 uppercase font-semibold m-0">
    TACTICAL EXPEDITION CLOCK
  </h1>

  <div class="mt-2 px-3 flex flex-col sm:flex-row items-center justify-center gap-1 sm:gap-3">
    <span class="text-base sm:text-xl md:text-2xl font-medium tracking-wider text-neutral-200 uppercase" id="location-name">
      London, United Kingdom · Europe
    </span>
    <span class="text-neutral-700 hidden sm:inline" aria-hidden="true">|</span>
    <span class="text-xs sm:text-sm font-mono-numbers tracking-[0.2em] text-neutral-400 uppercase" id="current-date">
      TUESDAY, OCTOBER 13, 2026
    </span>
  </div>

  <!-- Massive Centered Digital Clock Digits -->
  <div class="mt-2 sm:mt-3 mb-2 flex items-baseline justify-center font-mono-numbers select-none glow-subtle">
    <span
      class="text-[17vw] sm:text-[12vw] lg:text-[7.75rem] leading-none font-bold tracking-tight"
      id="hours"
      style="font-family: 'Orbitron', 'JetBrains Mono', monospace;"
    >21</span>

    <span class="text-[12vw] sm:text-[8.5vw] lg:text-[5.5rem] leading-none text-neutral-700 font-light px-1 sm:px-2 animate-pulse" aria-hidden="true">:</span>

    <span
      class="text-[17vw] sm:text-[12vw] lg:text-[7.75rem] leading-none font-bold tracking-tight"
      id="minutes"
      style="font-family: 'Orbitron', 'JetBrains Mono', monospace;"
    >03</span>

    <span class="text-[12vw] sm:text-[8.5vw] lg:text-[5.5rem] leading-none text-neutral-700 font-light px-1 sm:px-2 animate-pulse" aria-hidden="true">:</span>

    <span
      class="text-[17vw] sm:text-[12vw] lg:text-[7.75rem] leading-none font-bold tracking-tight"
      id="seconds"
      style="font-family: 'Orbitron', 'JetBrains Mono', monospace;"
    >02</span>

    <div class="flex flex-col justify-end pb-1 sm:pb-2 pl-2 sm:pl-3 select-none">
      <span
        class="border rounded-sm px-1.5 sm:px-2 py-0.5 text-[10px] sm:text-xs font-bold tracking-widest font-mono-numbers"
        id="clock-ampm"
        style="font-family: 'Orbitron', monospace;"
      >PM</span>
    </div>
  </div>

  <!-- Original Operator Medical ID Trigger below main clock -->
  <button
    class="mt-1 px-3 py-1 rounded-sm text-[10px] font-mono-numbers tracking-[0.2em] uppercase flex items-center gap-1.5 cursor-pointer transition-all"
    id="open-medical-id-btn"
    title="Operator Emergency & Personal Medical ID (ICE)"
    type="button"
  >
    <span class="material-symbols-outlined text-[13px]">medical_information</span>
    <span>[ OPERATOR MEDICAL ID // I.C.E. ]</span>
  </button>
</section>