---
// Footer.astro - Original Tactical Watch Bottom Action Dock
---

<footer class="relative z-10 w-full px-3 sm:px-6 mt-3 mb-3 flex flex-col items-center justify-center gap-2.5">
  <nav aria-label="Field Utilities" class="w-full max-w-4xl flex flex-wrap items-center justify-center gap-2">
    <button
      class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-sm text-[10px] sm:text-xs font-mono-numbers font-semibold tracking-[0.15em] uppercase cursor-pointer whitespace-nowrap transition-all"
      id="open-map-modal-btn"
      type="button"
    >
      <span class="material-symbols-outlined text-[15px]">map</span>
      <span>[ TACTICAL MAP ]</span>
    </button>

    <button
      class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-sm text-[10px] sm:text-xs font-mono-numbers font-semibold tracking-[0.15em] uppercase cursor-pointer whitespace-nowrap transition-all"
      id="open-survival-modal-btn"
      type="button"
    >
      <span class="material-symbols-outlined text-[15px]">menu_book</span>
      <span>[ SURVIVAL PROTOCOLS ]</span>
    </button>

    <button
      class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-sm text-[10px] sm:text-xs font-mono-numbers font-semibold tracking-[0.15em] uppercase cursor-pointer whitespace-nowrap transition-all"
      id="open-notes-btn"
      title="Tactical field notes"
      type="button"
    >
      <span class="material-symbols-outlined text-[15px]">edit_note</span>
      <span>[ FIELD NOTES ]</span>
    </button>
  </nav>

  <div class="w-full max-w-6xl flex items-center gap-3 pt-0.5">
    <div class="h-px flex-1 bg-gradient-to-r from-transparent via-neutral-800 to-neutral-700"></div>
    <span class="text-[9px] font-mono-numbers tracking-[0.3em] text-neutral-600 uppercase whitespace-nowrap">
      TACTICAL WATCH
    </span>
    <div class="h-px flex-1 bg-gradient-to-l from-transparent via-neutral-800 to-neutral-700"></div>
  </div>
</footer>