---
// Telemetry.astro - Tactical Expedition modules (Stitch design)
---

<!-- Survival Telemetry Instrument Strip: 3 Tactical Modules -->
<div class="mt-2 w-full max-w-6xl flex flex-col items-center gap-3 px-0 sm:px-2">
  <div class="w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 text-xs font-mono-numbers">

    <!-- 1. TACTICAL CHRONO MODULE -->
    <div class="p-3 flex flex-col justify-between transition-all relative overflow-hidden" id="chrono-module">
      <!-- Camo top accent -->
      <div class="absolute top-0 left-0 right-0 h-1 camo-accent-bar opacity-70"></div>

      <div class="flex items-center justify-between text-[10px] text-neutral-400 tracking-widest uppercase mb-1 pt-0.5">
        <div class="flex items-center gap-2">
          <span class="flex items-center gap-1 text-neutral-300 font-medium" id="timer-title-header">
            <span class="material-symbols-outlined text-[13px]">timer</span>TIMER
          </span>
          <span class="px-1.5 py-0.2 text-[8px] tracking-wider uppercase font-semibold border border-neutral-700 bg-neutral-900 text-neutral-300 hidden" id="pomo-mode-badge">POMODORO</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 bg-neutral-500" id="timer-status-dot"></span>
          <span class="text-[9px] tracking-widest font-semibold text-neutral-400" id="timer-status-badge">STANDBY</span>
        </div>
      </div>

      <!-- Pomodoro Select -->
      <div class="flex flex-wrap items-center gap-1 mb-1 pb-1 border-b border-neutral-800 text-[9px]">
        <span class="text-[8px] uppercase tracking-wider text-neutral-400 font-semibold flex items-center gap-0.5">
          <span class="material-symbols-outlined text-[10px]">military_tech</span>POMO:
        </span>
        <button class="px-2 py-0.5 uppercase font-semibold text-[8px] cursor-pointer transition-all" data-pomo="1500" title="Combat Focus: 25 Minutes">WORK 25M</button>
        <button class="px-2 py-0.5 uppercase font-semibold text-[8px] cursor-pointer transition-all" data-pomo="300" title="Tactical Break: 5 Minutes">REST 5M</button>
        <button class="px-2 py-0.5 uppercase font-semibold text-[8px] cursor-pointer transition-all" data-pomo="900" title="Regroup / Rest: 15 Minutes">LONG 15M</button>
        <button class="px-1.5 py-0.5 text-[8px] cursor-pointer uppercase font-mono-numbers ml-auto" id="silence-alarm-btn" style="display: none;" title="Acknowledge & Mute Alarm">MUTE ALARM</button>
      </div>

      <!-- Timer Digits + Steppers -->
      <div class="my-1 flex flex-wrap items-center justify-between gap-2">
        <span class="text-2xl text-neutral-200 font-semibold tracking-wider transition-colors drop-shadow" id="mission-timer" style="font-family: Orbitron, 'JetBrains Mono', monospace;">00:00:00</span>
        <div class="flex items-center gap-1 text-[9px]">
          <button class="px-2 sm:px-1.5 py-1 sm:py-0.5 text-xs font-semibold cursor-pointer transition-all" id="btn-sub-min" title="Subtract 1 Minute">-1M</button>
          <button class="px-2 sm:px-1.5 py-1 sm:py-0.5 text-xs font-semibold cursor-pointer transition-all" id="btn-add-min" title="Add 1 Minute">+1M</button>
          <button class="px-2 sm:px-1.5 py-1 sm:py-0.5 text-xs font-semibold cursor-pointer transition-all" id="btn-add-5m" title="Add 5 Minutes">+5M</button>
          <button class="px-2 sm:px-1.5 py-1 sm:py-0.5 text-xs font-semibold cursor-pointer transition-all" id="btn-add-10m" title="Add 10 Minutes">+10M</button>
        </div>
      </div>

      <!-- Presets + Actions -->
      <div class="pt-2 mt-1 border-t border-neutral-800 flex items-center justify-between gap-1 text-[9px] flex-wrap">
        <div class="flex flex-wrap items-center gap-1 text-neutral-400">
          <span class="text-[8px] uppercase tracking-wider text-neutral-500">PRESETS:</span>
          <button class="px-2 sm:px-1.5 py-1 sm:py-0.5 cursor-pointer uppercase font-mono-numbers font-semibold" data-preset="300">5M</button>
          <button class="px-2 sm:px-1.5 py-1 sm:py-0.5 cursor-pointer uppercase font-mono-numbers font-semibold" data-preset="900">15M</button>
          <button class="px-2 sm:px-1.5 py-1 sm:py-0.5 cursor-pointer uppercase font-mono-numbers font-semibold" data-preset="1800">30M</button>
          <button class="px-2 sm:px-1.5 py-1 sm:py-0.5 cursor-pointer uppercase font-mono-numbers font-semibold" id="btn-clear-timer" title="Reset to Zero">CLEAR</button>
        </div>
        <div class="flex items-center gap-1.5 ml-auto">
          <button class="px-3 sm:px-2.5 py-1 sm:py-0.5 font-semibold tracking-wider uppercase flex items-center gap-1 cursor-pointer transition-all" id="timer-toggle-btn">
            <span class="material-symbols-outlined text-[11px]" id="timer-toggle-icon">play_arrow</span>
            <span id="timer-toggle-label">START</span>
          </button>
          <button class="px-2 py-1 sm:py-0.5 cursor-pointer uppercase tracking-wider text-[9px] font-semibold transition-all" id="chrono-reset-btn">RESET</button>
        </div>
      </div>
    </div>

    <!-- 2. DIGITAL COMPASS / AZIMUTH MODULE -->
    <div class="p-3 flex flex-col justify-between transition-all relative overflow-hidden" id="compass-module">
      <!-- Camo top accent -->
      <div class="absolute top-0 left-0 right-0 h-1 camo-accent-bar opacity-70"></div>

<div class="flex flex-wrap items-center justify-between gap-x-2 gap-y-1.5 text-[10px] text-neutral-400 tracking-widest uppercase mb-1 pt-0.5">
  <div class="flex items-center gap-1.5 text-neutral-300 font-semibold">
    <span class="material-symbols-outlined text-[14px]">explore</span>
    <span>DIGITAL COMPASS</span>
    <span class="px-1.5 py-0.2 text-[8px] tracking-wider uppercase bg-neutral-900 border border-neutral-700 text-neutral-300">AZIMUTH</span>
  </div>
  <div class="flex items-center gap-1">
    <button
      class="px-2 sm:px-1.5 py-1 sm:py-0.5 text-[8px] uppercase tracking-wider transition-colors cursor-pointer"
      id="compass-mode-btn"
      title="Toggle Dial vs Tape View"
    >
      MODE: DIAL
    </button>
    <button
      class="px-2 sm:px-1.5 py-1 sm:py-0.5 text-[8px] uppercase tracking-wider transition-colors cursor-pointer"
      id="compass-device-btn"
      title="Use real device compass (mobile sensor)"
    >
      SENSOR
    </button>
    <button
      class="px-2 sm:px-1.5 py-1 sm:py-0.5 text-[8px] uppercase tracking-wider transition-colors cursor-pointer"
      id="compass-lock-btn"
      title="Lock / Unlock Current Azimuth"
    >
      LOCK
    </button>
  </div>
</div>

      <!-- Compass Display -->
      <div class="relative py-1 flex items-center justify-between gap-3">
        <div class="relative w-24 h-24 shrink-0 flex items-center justify-center cursor-grab active:cursor-grabbing" id="compass-dial-container" title="Drag or move cursor to orient compass">
          <div class="absolute inset-0 border border-neutral-700 bg-neutral-950 pointer-events-none"></div>
          <div class="absolute -top-1 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center pointer-events-none">
            <div class="w-0 h-0 border-l-[3.5px] border-l-transparent border-r-[3.5px] border-r-transparent border-t-[6px] border-t-white drop-shadow"></div>
          </div>
          <svg class="compass-dial-ring w-22 h-22 select-none" id="compass-svg" style="transform: rotate(-184deg);" viewBox="0 0 100 100">
            <circle cx="50" cy="50" fill="none" r="44" stroke="rgba(255,255,255,0.15)" stroke-dasharray="2,2" stroke-width="1"></circle>
            <circle cx="50" cy="50" fill="none" r="36" stroke="rgba(255,255,255,0.2)" stroke-width="0.75"></circle>
            <g stroke="rgba(255,255,255,0.35)" stroke-width="1.2">
              <line x1="50" x2="50" y1="7" y2="12"></line>
              <line transform="rotate(30 50 50)" x1="50" x2="50" y1="7" y2="10"></line>
              <line transform="rotate(60 50 50)" x1="50" x2="50" y1="7" y2="10"></line>
              <line transform="rotate(90 50 50)" x1="50" x2="50" y1="7" y2="12"></line>
              <line transform="rotate(120 50 50)" x1="50" x2="50" y1="7" y2="10"></line>
              <line transform="rotate(150 50 50)" x1="50" x2="50" y1="7" y2="10"></line>
              <line transform="rotate(180 50 50)" x1="50" x2="50" y1="7" y2="12"></line>
              <line transform="rotate(210 50 50)" x1="50" x2="50" y1="7" y2="10"></line>
              <line transform="rotate(240 50 50)" x1="50" x2="50" y1="7" y2="10"></line>
              <line transform="rotate(270 50 50)" x1="50" x2="50" y1="7" y2="12"></line>
              <line transform="rotate(300 50 50)" x1="50" x2="50" y1="7" y2="10"></line>
              <line transform="rotate(330 50 50)" x1="50" x2="50" y1="7" y2="10"></line>
            </g>
            <text fill="#ffffff" font-family="Orbitron, monospace" font-size="8" font-weight="bold" text-anchor="middle" x="50" y="21">N</text>
            <text fill="#a3a3a3" font-family="Orbitron, monospace" font-size="7" font-weight="semibold" text-anchor="middle" x="80" y="52.5">E</text>
            <text fill="#a3a3a3" font-family="Orbitron, monospace" font-size="7" font-weight="semibold" text-anchor="middle" x="50" y="83">S</text>
            <text fill="#a3a3a3" font-family="Orbitron, monospace" font-size="7" font-weight="semibold" text-anchor="middle" x="20" y="52.5">W</text>
            <polygon fill="#ffffff" points="50,14 47.5,50 52.5,50"></polygon>
            <polygon fill="#525252" points="50,86 47.5,50 52.5,50"></polygon>
            <circle cx="50" cy="50" fill="#000000" r="3.5" stroke="#a3a3a3" stroke-width="1.2"></circle>
          </svg>
          <div class="absolute inset-0 pointer-events-none flex items-center justify-center">
            <div class="w-1 h-1 bg-white"></div>
          </div>
        </div>

        <!-- Heading Value HUD -->
        <div class="flex-1 flex flex-col justify-center min-w-0">
          <div class="flex items-baseline gap-2">
            <span class="text-2xl md:text-3xl font-bold text-white tracking-wider font-mono-numbers drop-shadow" id="compass-degrees" style="font-family: Orbitron, monospace;">184°</span>
            <span class="text-xs md:text-sm font-bold text-neutral-300 tracking-widest font-mono-numbers" id="compass-cardinal">S</span>
            <span class="text-[9px] px-1 py-0.2 border border-neutral-700 text-neutral-400 bg-neutral-900 ml-auto font-mono-numbers hidden sm:inline" id="compass-lock-indicator">UNLOCKED</span>
          </div>
          <div class="mt-1.5 w-full h-5 bg-black border border-neutral-800 overflow-hidden relative flex items-center" id="compass-tape-container">
            <div class="absolute inset-y-0 left-1/2 -translate-x-1/2 w-0.5 bg-white z-10"></div>
            <div class="compass-tape-strip flex items-center gap-4 text-[9px] font-mono-numbers text-neutral-400 select-none whitespace-nowrap pl-1" id="compass-tape-strip"></div>
          </div>
          <div class="mt-1.5 flex flex-wrap items-center justify-between gap-x-2 gap-y-0.5 text-[9px] text-neutral-400 font-mono-numbers">
            <span>AZIMUTH: <span class="text-neutral-200 font-semibold" id="azimuth-mils">3278 MIL</span></span>
            <span class="text-neutral-400">WP: <span class="text-neutral-200 font-semibold" id="compass-wp-brg">---°</span></span>
            <span class="text-neutral-600">|</span>
            <span>VAR: <span class="text-neutral-300" id="azimuth-declination">+1.2° E</span></span>
            <span class="text-neutral-600">|</span>
            <span class="text-neutral-300 font-medium" id="compass-source">GYRO/SIM</span>
          </div>
        </div>
      </div>

      <!-- Bottom Compass Status -->
      <div class="pt-2 mt-1 border-t border-neutral-800 flex flex-wrap items-center justify-between gap-2 text-[9px] text-neutral-500 tracking-wider">
        <div class="flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 bg-neutral-400 animate-pulse"></span>
          <span>TRUE NORTH CORR: ACTIVE</span>
        </div>
        
        <button class="px-2 py-1 sm:py-0.5 font-semibold uppercase text-[8px] cursor-pointer" id="btn-recalibrate-compass" title="Recalibrate Compass Sensor">CALIBRATE 0°</button>
      </div>
    </div>

    <!-- 3. UTC REFERENCE & EMERGENCY BEACON -->
    <div class="p-3 flex flex-col justify-between transition-all relative overflow-hidden md:col-span-2 lg:col-span-1" id="utc-module">
      <!-- Camo top accent -->
      <div class="absolute top-0 left-0 right-0 h-1 camo-accent-bar opacity-70"></div>

      <div class="flex flex-wrap items-center justify-between gap-x-2 gap-y-1.5 text-[10px] text-neutral-400 tracking-widest uppercase mb-1 pt-0.5">
        <div class="flex items-center gap-1.5 text-neutral-300 font-semibold">
          <span class="material-symbols-outlined text-[13px]">cell_tower</span>
          <span>TACTICAL EMERGENCY BEACON</span>
          <span class="px-1.5 py-0.2 text-[8px] tracking-wider uppercase bg-neutral-900 border border-neutral-700 text-neutral-300">HUD</span>
        </div>
        <div class="flex items-center gap-1">
          <span class="px-1.5 py-0.5 bg-neutral-900 border border-neutral-800 text-neutral-300 text-[9px] font-mono-numbers font-semibold" id="utc-offset">UTC+1</span>
          <span class="px-1.5 py-0.5 bg-neutral-900 border border-neutral-800 text-neutral-300 text-[9px] font-mono-numbers font-semibold" id="zulu-time">2003Z</span>
        </div>
      </div>

      <!-- Emergency Action Grid -->
      <div class="mt-1.5 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-1.5 text-neutral-200">
        <span class="text-[10px] text-neutral-400 tracking-wider">EMERGENCY:</span>
        <div class="grid grid-cols-2 gap-1.5 w-full sm:w-auto">
          <button class="flex items-center justify-center gap-1.5 text-[9px] px-2.5 py-2 sm:py-1 font-semibold tracking-wider cursor-pointer select-none font-mono-numbers transition-all" id="whistle-toggle-btn" title="Sound Tactical Dual-Tone Survival Whistle Blast">
            <span class="w-1.5 h-1.5 bg-amber-200" id="whistle-dot"></span>
            <span class="material-symbols-outlined text-[12px]" id="whistle-icon">sports</span>
            <span id="whistle-label">WHISTLE</span>
          </button>
          <button class="flex items-center justify-center gap-1.5 text-[9px] px-2.5 py-2 sm:py-1 font-semibold tracking-wider cursor-pointer select-none font-mono-numbers transition-all" id="torch-field-btn" title="Toggle Solid White Flashlight Screen">
            <span class="w-1.5 h-1.5 bg-amber-200" id="torch-field-dot"></span>
            <span class="material-symbols-outlined text-[12px]">flashlight_on</span>
            <span id="torch-field-label">TORCH</span>
          </button>
          <button class="flex items-center justify-center gap-1.5 text-[9px] px-2.5 py-2 sm:py-1 font-semibold tracking-wider cursor-pointer select-none font-mono-numbers transition-all" id="torch-toggle" title="Toggle Fullscreen Tactical Strobe Light">
            <span class="w-1.5 h-1.5 bg-amber-200" id="torch-dot"></span>
            <span class="material-symbols-outlined text-[12px]">flash_on</span>
            <span id="torch-label">STROBE</span>
          </button>
          <button class="flex items-center justify-center gap-1.5 text-[9px] px-2.5 py-2 sm:py-1 font-semibold tracking-wider cursor-pointer select-none font-mono-numbers transition-all" id="sos-toggle-btn" title="Toggle Emergency Morse SOS Distress Loop (121.5 MHz)">
            <span class="w-2 h-2 bg-amber-300" id="sos-beacon-dot"></span>
            <span id="sos-btn-label">SOS DISTRESS</span>
          </button>
        </div>
      </div>

      <!-- Morse visualizer -->
      <div class="pt-1.5 mt-1 border-t border-neutral-800 flex flex-wrap items-center justify-between gap-1.5 text-[9px] tracking-widest" id="sos-telemetry-row">
        <div class="flex items-center gap-1.5">
          <span class="text-neutral-500" id="sos-freq-label">DISTRESS: 121.5 MHz</span>
          <span class="hidden items-center gap-1 text-amber-300 font-bold" id="sos-active-status">
            <span class="w-1.5 h-1.5 bg-amber-400 animate-ping"></span>
            <span>TRANSMITTING</span>
          </span>
        </div>
        <div class="flex items-center gap-1 font-mono-numbers text-[10px] text-neutral-500 tracking-normal" id="morse-visualizer">
          <span class="morse-pip px-1 py-0.2 border border-neutral-800 bg-black text-neutral-500" id="pip-0">·</span>
          <span class="morse-pip px-1 py-0.2 border border-neutral-800 bg-black text-neutral-500" id="pip-1">·</span>
          <span class="morse-pip px-1 py-0.2 border border-neutral-800 bg-black text-neutral-500" id="pip-2">·</span>
          <span class="text-neutral-700 mx-0.5">/</span>
          <span class="morse-pip px-1.5 py-0.2 border border-neutral-800 bg-black text-neutral-500" id="pip-3">—</span>
          <span class="morse-pip px-1.5 py-0.2 border border-neutral-800 bg-black text-neutral-500" id="pip-4">—</span>
          <span class="morse-pip px-1.5 py-0.2 border border-neutral-800 bg-black text-neutral-500" id="pip-5">—</span>
          <span class="text-neutral-700 mx-0.5">/</span>
          <span class="morse-pip px-1.5 py-0.2 border border-neutral-800 bg-black text-neutral-500" id="pip-6">·</span>
          <span class="morse-pip px-1.5 py-0.2 border border-neutral-800 bg-black text-neutral-500" id="pip-7">·</span>
          <span class="morse-pip px-1.5 py-0.2 border border-neutral-800 bg-black text-neutral-500" id="pip-8">·</span>
        </div>
      </div>

      <div class="pt-1.5 mt-1 border-t border-neutral-800 flex flex-wrap items-center justify-between gap-1 text-[9px] text-neutral-500 tracking-widest">
        <span>GEODETIC REF: WGS84</span>
        <span class="text-neutral-400 font-mono-numbers">SYNCHRONIZED</span>
      </div>
    </div>

  </div>
</div>