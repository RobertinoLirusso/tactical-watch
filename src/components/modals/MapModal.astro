---
// MapModal.astro
---

<div class="fixed inset-0 z-50 bg-black/85 backdrop-blur-sm hidden items-center justify-center p-2 sm:p-4" id="tactical-map-modal">
  <div class="relative w-full max-w-5xl max-h-[92dvh] bg-[#0c0c0c] border border-neutral-700 shadow-2xl flex flex-col overflow-y-auto overflow-x-hidden tactical-scroll text-neutral-200">
    
    <!-- Military Camo Top Strip -->
    <div class="h-2 camo-strip-pattern border-b border-neutral-800 shrink-0"></div>

    <!-- Header -->
    <div class="px-4 py-3 border-b border-neutral-800 flex items-center justify-between gap-2 bg-[#111111]">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <h3 class="text-xs sm:text-sm font-bold tracking-widest uppercase font-mono-numbers text-white">
          [ TACTICAL CARTOGRAPHY // MAP HUD ]
        </h3>
      </div>
      <button type="button" class="px-2.5 py-1 bg-neutral-900 border border-neutral-700 hover:border-white text-xs font-mono-numbers uppercase transition-colors flex items-center gap-1 cursor-pointer" id="close-map-modal-btn">
        <span class="material-symbols-outlined text-[14px]">close</span>
        CLOSE
      </button>
    </div>

    <!-- Controls -->
    <div class="px-4 py-2 bg-black border-b border-neutral-800 flex flex-wrap items-center justify-between gap-2 text-xs font-mono-numbers">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-neutral-400 uppercase tracking-wider text-[10px]">COORDINATES:</span>
        <span class="text-white font-bold tracking-wider text-[11px]" id="leaflet-coords-display">
          LAT: 51.5074° N | LON: 0.1278° W
        </span>
        <span class="text-neutral-500 text-[10px]" id="leaflet-zoom-display">ZOOM: 12x</span>
      </div>
      <div class="flex items-center gap-1.5 flex-wrap">
        <button type="button" class="px-2 py-1 bg-neutral-900 border border-neutral-700 hover:border-white text-[10px] uppercase tracking-wider whitespace-nowrap flex items-center gap-1 cursor-pointer transition-colors" id="map-recenter-btn">
          <span class="material-symbols-outlined text-[12px]">my_location</span>GPS CENTER
        </button>
        <button type="button" class="px-2 py-1 bg-neutral-900 border border-neutral-700 hover:border-white text-[10px] uppercase tracking-wider whitespace-nowrap flex items-center gap-1 cursor-pointer transition-colors" id="map-city-btn">
          <span class="material-symbols-outlined text-[12px]">location_city</span>CITY / ZONE
        </button>
        <button type="button" class="px-2 py-1 bg-neutral-900 border border-neutral-700 hover:border-amber-400 text-[10px] uppercase tracking-wider whitespace-nowrap flex items-center gap-1 cursor-pointer transition-colors text-amber-200" id="map-waypoint-btn">
          <span class="material-symbols-outlined text-[12px]">add_location_alt</span>MARK WAYPOINT
        </button>
        <button type="button" class="px-2 py-1 bg-neutral-900 border border-neutral-700 hover:border-emerald-400 text-[10px] uppercase tracking-wider whitespace-nowrap flex items-center gap-1 cursor-pointer transition-colors text-emerald-200" id="map-cache-btn">
          <span class="material-symbols-outlined text-[12px]">download</span>CACHE TILES
        </button>
        <button type="button" class="px-2 py-1 bg-neutral-900 border border-neutral-700 hover:border-white text-[10px] uppercase tracking-wider whitespace-nowrap flex items-center gap-1 cursor-pointer transition-colors" id="map-copy-coords-btn">
          <span class="material-symbols-outlined text-[12px]">content_copy</span>COPY COORDS
        </button>
      </div>
    </div>

    <!-- Waypoint Navigation Strip -->
    <div class="px-4 py-1.5 bg-neutral-950 border-b border-neutral-800 flex flex-wrap items-center gap-3 text-[10px] font-mono-numbers">
      <span class="text-neutral-500 uppercase tracking-wider">NAV TO WP:</span>
      <span class="text-amber-300 font-bold" id="nav-bearing">BRG ---°</span>
      <span class="text-neutral-600" aria-hidden="true">|</span>
      <span class="text-amber-200 font-bold" id="nav-distance">DIST --- km</span>
      <span class="text-neutral-600" aria-hidden="true">|</span>
      <span class="text-neutral-400" id="nav-status">NO WAYPOINT</span>
    </div>

    <!-- Map Container -->
    <div class="relative w-full shrink-0 h-[55dvh] min-h-[280px] sm:h-[520px] bg-neutral-950" id="leaflet-map-wrapper">
      <div class="w-full h-full" id="leaflet-offline-map"></div>
      
      <!-- Crosshair -->
      <div class="absolute inset-0 pointer-events-none flex items-center justify-center z-[400]">
        <div class="w-6 h-6 border border-white/40 relative flex items-center justify-center">
          <div class="w-1 h-1 bg-white"></div>
          <div class="absolute w-10 h-[1px] bg-white/30"></div>
          <div class="absolute h-10 w-[1px] bg-white/30"></div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div class="px-4 py-2 border-t border-neutral-800 bg-[#111111] flex flex-wrap items-center justify-between gap-2 text-[10px] font-mono-numbers text-neutral-400">
      <div class="flex flex-wrap items-center gap-2">
        <span>TILE ENGINE: CARTO DB / OSM</span>
        <span class="text-neutral-600" aria-hidden="true">|</span>
        <span class="text-emerald-400 font-semibold" id="map-cache-status">TILES CACHED: STANDALONE READY</span>
      </div>
      <span class="text-neutral-400 tracking-wider uppercase">
        OFFLINE CARTOGRAPHY READY
      </span>
    </div>
  </div>
</div>