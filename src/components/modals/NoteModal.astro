<div class="fixed inset-0 z-50 bg-black/85 backdrop-blur-sm hidden items-center justify-center p-2 sm:p-4" id="notes-modal">
  <div class="relative w-full max-w-lg max-h-[85dvh] bg-[#0c0c0c] border border-neutral-700 shadow-2xl flex flex-col overflow-hidden text-neutral-200 font-mono-numbers">
    <div class="h-2 camo-strip-pattern border-b border-neutral-800 shrink-0"></div>

    <div class="px-4 py-3 border-b border-neutral-800 flex items-center justify-between bg-[#111]">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-amber-300 text-[18px]">edit_note</span>
        <h3 class="text-xs font-bold tracking-widest uppercase text-white">[ FIELD NOTES // SCRATCHPAD ]</h3>
      </div>
      <button type="button" class="px-2.5 py-1 bg-neutral-900 border border-neutral-700 hover:border-white text-xs uppercase cursor-pointer transition-colors" id="close-notes-btn">CLOSE</button>
    </div>

    <div class="p-4 flex-1 overflow-y-auto bg-[#0a0a0a]">
      <textarea
        id="notes-textarea"
        class="w-full h-56 bg-neutral-950 border border-neutral-700 px-3 py-2 text-xs text-neutral-100 placeholder-neutral-600 focus:outline-none focus:border-white resize-none leading-relaxed"
        placeholder="Field notes, observations, grid references..."
      ></textarea>
      <p class="mt-2 text-[10px] text-neutral-500" id="notes-status">LOCAL STORAGE · AUTO-SAVE OFF</p>
    </div>

    <div class="px-4 py-3 border-t border-neutral-800 bg-[#111] flex justify-between gap-2 text-[11px]">
      <button type="button" class="px-3 py-1.5 bg-neutral-900 border border-neutral-700 hover:border-red-500 text-neutral-300 uppercase tracking-wider cursor-pointer transition-colors" id="notes-clear-btn">CLEAR</button>
      <button type="button" class="px-3.5 py-1.5 bg-emerald-950/70 border border-emerald-700 hover:border-emerald-400 text-emerald-200 font-bold uppercase tracking-wider flex items-center gap-1.5 cursor-pointer transition-colors" id="notes-save-btn">
        <span class="material-symbols-outlined text-[14px]">save</span>
        SAVE NOTE
      </button>
    </div>
  </div>
</div>