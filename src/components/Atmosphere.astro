---
// Atmosphere.astro - Dynamic Atmospheric System (7 phases) + Tactical Vignette
---

<!-- DYNAMIC ATMOSPHERIC SYSTEM LAYERS (7 Phases) -->
<div class="cycle-layer bg-dawn" id="layer-dawn">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom,rgba(251,191,36,0.22)_0%,transparent_60%)]"></div>
  <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-amber-950/40 via-transparent to-transparent"></div>
</div>

<div class="cycle-layer bg-morning" id="layer-morning">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(56,189,248,0.2)_0%,transparent_65%)]"></div>
</div>

<div class="cycle-layer bg-noon" id="layer-noon">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(255,255,255,0.28)_0%,transparent_50%)]"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(186,230,253,0.18)_0%,transparent_70%)]"></div>
</div>

<div class="cycle-layer bg-afternoon" id="layer-afternoon">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_30%_60%,rgba(245,158,11,0.18)_0%,transparent_65%)]"></div>
</div>

<div class="cycle-layer bg-sunset" id="layer-sunset">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom,rgba(244,63,94,0.32)_0%,rgba(168,85,247,0.18)_40%,transparent_75%)]"></div>
</div>

<div class="cycle-layer bg-night" id="layer-night">
  <div class="absolute inset-0 sky-stars opacity-60"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_70%_20%,rgba(99,102,241,0.15)_0%,transparent_60%)]"></div>
</div>

<div class="cycle-layer bg-midnight active" id="layer-midnight">
  <div class="absolute inset-0 sky-stars opacity-80"></div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_40%,rgba(15,23,42,0.4)_0%,transparent_80%)]"></div>
</div>

<!-- Strong tactical vignette for maximum legibility -->
<div class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_center,rgba(0,0,0,0.35)_0%,rgba(0,0,0,0.92)_88%)]"></div>
<div class="absolute inset-0 pointer-events-none bg-gradient-to-t from-black/85 via-black/30 to-black/75"></div>

<!-- Top Camo Accent Strip -->
<div class="relative z-10 w-full h-1.5 camo-strip-pattern border-b border-white/10 opacity-80"></div>