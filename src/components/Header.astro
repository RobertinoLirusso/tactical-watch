---
// Header.astro - Tactical Telemetry Header (Stitch design)
---

<header class="relative z-10 w-full pt-3 md:pt-4 px-2 sm:px-4 md:px-6 flex flex-col items-center gap-2">
  <div class="w-full max-w-7xl mx-auto flex flex-col lg:flex-row lg:flex-wrap items-center justify-between gap-2 sm:gap-2.5 px-0 sm:px-2">

    <!-- GPS Fix & Position (click → modal) -->
    <button
      type="button"
      id="open-geo-modal-btn"
      class="max-w-full flex flex-wrap items-center justify-center gap-x-2 gap-y-0.5 text-[10px] font-mono-numbers tracking-wider sm:tracking-widest text-neutral-400 bg-neutral-950/90 border border-neutral-800 px-3 sm:px-3.5 py-1.5 shadow-md cursor-pointer hover:border-neutral-600 transition-colors text-left"
      title="Open detailed coordinates"
    >
      <span class="flex items-center gap-1.5 text-neutral-200 font-semibold">
        <span class="w-1.5 h-1.5 bg-neutral-300 animate-pulse" id="gps-fix-dot"></span>
        <span id="gps-fix-label">GPS FIX</span>
      </span>
      <span class="text-neutral-600">/</span>
      <span class="text-neutral-300" id="geo-coords">--° N, --° W</span>
      <span class="text-neutral-600">/</span>
      <span class="text-neutral-400">ALT <span class="text-neutral-200" id="geo-alt">-- m MSL</span></span>
    </button>

    <!-- Weather Telemetry -->
    <div class="max-w-full flex flex-wrap items-center justify-center gap-x-2.5 gap-y-1 text-[10px] font-mono-numbers tracking-wider sm:tracking-widest text-neutral-300 bg-neutral-950/90 border border-neutral-800 px-3 sm:px-4 py-1.5 shadow-md">
      <div class="flex items-center gap-1.5">
        <span class="material-symbols-outlined text-neutral-400 text-[14px]" id="weather-icon">cloud</span>
        <span class="text-sm font-semibold text-white tracking-tight" id="weather-temp">13°C</span>
        <span class="text-neutral-500 text-[9px] uppercase tracking-normal" id="weather-feels">FEELS 11°C</span>
      </div>
      <span class="text-neutral-600">/</span>
      <span class="text-neutral-300 font-medium uppercase text-[10px]" id="weather-condition">OVERCAST / LIGHT MIST</span>
      <span class="text-neutral-600">/</span>
      <span class="flex items-center gap-1 text-neutral-400">
        <span class="material-symbols-outlined text-[12px] text-neutral-400">water_drop</span>
        <span id="weather-humidity">78%</span>
      </span>
      <span class="text-neutral-600">•</span>
      <span class="flex items-center gap-1 text-neutral-400">
        <span class="material-symbols-outlined text-[12px] text-neutral-400">air</span>
        <span id="weather-wind">18 km/h NW</span>
      </span>
      <span class="sr-only" id="weather-status" role="status" aria-live="polite">Loading live weather data</span>
    </div>

    <!-- Timezone Selector -->
    <div class="max-w-full inline-flex items-center gap-3 px-3 sm:px-3.5 py-1.5 bg-neutral-950/90 border border-neutral-800 shadow-md">
      <div class="flex items-center gap-2 pl-1">
        <span class="text-[10px] tracking-widest uppercase font-mono-numbers text-neutral-400 font-medium select-none">ZONE</span>
        <div class="relative min-w-0 flex items-center border border-neutral-700 bg-black/60 px-2 py-0.5">
          <select
            class="bg-transparent text-xs font-light tracking-wider text-white focus:outline-none cursor-pointer appearance-none pr-5 py-1 sm:py-0.5 max-w-[60vw] sm:max-w-none"
            id="timezone-select"
            style="appearance: none;"
          >
            <option class="bg-neutral-950 text-white font-semibold" selected value="LOCAL_AUTO">LOCAL / AUTO (SYSTEM)</option>
            <option class="bg-neutral-950 text-white" value="Europe/London">London (GMT/BST)</option>
            <option class="bg-neutral-950 text-white" value="Europe/Madrid">Madrid (CEST/CET)</option>
            <option class="bg-neutral-950 text-white" value="America/New_York">New York (EDT/EST)</option>
            <option class="bg-neutral-950 text-white" value="America/Argentina/Buenos_Aires">Buenos Aires (ART)</option>
            <option class="bg-neutral-950 text-white" value="America/Mexico_City">Mexico City (CST)</option>
            <option class="bg-neutral-950 text-white" value="America/Bogota">Bogota (COT)</option>
            <option class="bg-neutral-950 text-white" value="America/Santiago">Santiago (CLT)</option>
            <option class="bg-neutral-950 text-white" value="Asia/Tokyo">Tokyo (JST)</option>
            <option class="bg-neutral-950 text-white" value="Asia/Dubai">Dubai (GST)</option>
            <option class="bg-neutral-950 text-white" value="Australia/Sydney">Sydney (AEST)</option>
          </select>
          <svg class="w-3 h-3 text-neutral-400 pointer-events-none absolute right-1.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path d="M19 9l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </div>
      </div>
    </div>

    <!-- Barometer & Heading -->
    <div class="max-w-full flex flex-wrap items-center justify-center gap-x-2 gap-y-0.5 text-[10px] font-mono-numbers tracking-wider sm:tracking-widest text-neutral-400 bg-neutral-950/90 border border-neutral-800 px-3 sm:px-3.5 py-1.5 shadow-md">
      <span class="flex items-center gap-1 text-neutral-300 font-medium">
        <span class="material-symbols-outlined text-[13px]">speed</span>
        <span id="geo-baro">1014 hPa</span>
      </span>
      <span class="text-neutral-600">•</span>
      <span class="text-neutral-400 font-medium">STABLE</span>
      <span class="text-neutral-600">/</span>
      <span class="text-neutral-300 font-semibold flex items-center gap-1">
        <span class="material-symbols-outlined text-[13px] text-neutral-400">explore</span>
        <span id="geo-hdg">184° S</span>
      </span>
    </div>
  </div>

  <!-- Day Phase + Moon -->
  <div class="pt-0.5 flex items-center justify-center gap-2 flex-wrap">
    <div class="inline-flex items-center gap-2 px-3 py-0.5 bg-neutral-950/90 border border-neutral-800 text-[11px] font-mono-numbers tracking-widest shadow-md">
      <span class="w-1.5 h-1.5 bg-neutral-400 animate-pulse" id="phase-pulse-dot"></span>
      <span class="material-symbols-outlined text-[13px] text-neutral-300" id="phase-icon">dark_mode</span>
      <span class="font-medium text-neutral-300 tracking-wider text-[10px] uppercase" id="phase-name">NIGHT</span>
    </div>
  </div>
</header>

<!-- GEO DETAIL MODAL -->
<div class="fixed inset-0 z-50 bg-black/85 hidden items-center justify-center p-3 sm:p-6" id="geo-detail-modal">
  <div class="relative w-full max-w-md bg-[#0c0c0c] border border-neutral-700 flex flex-col shadow-2xl overflow-hidden text-neutral-200 font-mono-numbers">
    <div class="h-2 camo-strip-pattern border-b border-neutral-800"></div>

    <div class="px-4 py-3 border-b border-neutral-800 flex items-center justify-between bg-[#111]">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 bg-neutral-300 animate-pulse"></span>
        <span class="material-symbols-outlined text-neutral-300 text-lg">my_location</span>
        <div>
          <h3 class="text-xs font-bold tracking-[0.2em] uppercase text-white">GEODETIC POSITION</h3>
          <p class="text-[9px] text-neutral-400 tracking-wider" id="geo-modal-source">SOURCE: USER GPS</p>
        </div>
      </div>
      <button type="button" class="px-2 py-1 text-xs uppercase cursor-pointer" id="close-geo-modal-btn">CLOSE</button>
    </div>

    <div class="p-4 space-y-3 text-xs">
      <div class="flex gap-2">
        <button type="button" class="flex-1 px-2 py-1.5 border border-neutral-600 bg-neutral-900 text-[9px] uppercase tracking-wider cursor-pointer" id="geo-source-user-btn">USER GPS</button>
        <button type="button" class="flex-1 px-2 py-1.5 border border-neutral-800 bg-black text-[9px] uppercase tracking-wider cursor-pointer text-neutral-400" id="geo-source-city-btn">SELECTED CITY</button>
      </div>

      <div class="grid grid-cols-1 gap-2">
        <div class="p-3 bg-[#0e0e0e] border border-neutral-800">
          <div class="text-[9px] text-neutral-500 uppercase tracking-wider mb-1">Latitude</div>
          <div class="text-sm text-white font-semibold" id="geo-modal-lat">--</div>
        </div>
        <div class="p-3 bg-[#0e0e0] border border-neutral-800">
          <div class="text-[9px] text-neutral-500 uppercase tracking-wider mb-1">Longitude</div>
          <div class="text-sm text-white font-semibold" id="geo-modal-lon">--</div>
        </div>
        <div class="p-3 bg-[#0e0e0] border border-neutral-800">
          <div class="text-[9px] text-neutral-500 uppercase tracking-wider mb-1">Altitude</div>
          <div class="text-sm text-white font-semibold" id="geo-modal-alt">--</div>
        </div>
        <div class="p-3 bg-[#0e0e0] border border-neutral-800">
          <div class="text-[9px] text-neutral-500 uppercase tracking-wider mb-1">Decimal pair</div>
          <div class="text-sm text-neutral-200 break-all" id="geo-modal-decimal">--</div>
        </div>
        <div class="p-3 bg-[#0e0e0] border border-neutral-800">
          <div class="text-[9px] text-neutral-500 uppercase tracking-wider mb-1">Place / zone</div>
          <div class="text-sm text-neutral-200" id="geo-modal-place">--</div>
        </div>
      </div>
    </div>

    <div class="px-4 py-3 border-t border-neutral-800 bg-[#111] flex items-center justify-between gap-2 text-[10px]">
      <span class="text-neutral-500" id="geo-copy-feedback"></span>
      <button type="button" class="px-4 py-1.5 font-bold uppercase cursor-pointer flex items-center gap-1 border border-neutral-600 bg-neutral-900 hover:border-neutral-400" id="geo-copy-btn">
        <span class="material-symbols-outlined text-[13px]">content_copy</span>
        COPY COORDS
      </button>
    </div>
  </div>
</div>