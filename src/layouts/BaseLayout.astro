---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const siteName = "Tactical Watch";

const {
  title = "Tactical Expedition Clock | World Clock, Mission Timer & Compass",
  description = "Free tactical world clock with 22 time zones, mission timer, digital compass, live weather, offline maps, flashlight, SOS beacon and emergency medical ID. No sign-up required.",
  image = "/og-image.png",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Tactical Expedition Clock",
  alternateName: siteName,
  url: canonicalURL.href,
  description,
  image: imageURL.href,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Any",
  browserRequirements: "Requires JavaScript and a modern web browser",
  inLanguage: "en",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  featureList: [
    "World clock with 22 time zones",
    "Mission countdown timer",
    "Digital compass",
    "Live weather telemetry",
    "Offline map",
    "Flashlight and strobe signal",
    "Emergency medical ID (ICE)",
    "Field notes",
  ],
};
---

<!doctype html>
<html class="h-full" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Icons & PWA -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Tactical Expedition Clock showing a large digital time readout" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content="Tactical Expedition Clock showing a large digital time readout" />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@200;300;400;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Leaflet CSS (para el mapa) -->
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css"
  crossorigin=""
/>
  </head>

  <body class="h-full bg-black text-neutral-200 m-0 p-0 flex flex-col justify-between overflow-x-hidden overflow-y-auto select-none relative">
    
    <slot />

    <!-- TORCH - Pantalla blanca completa -->
<div 
  class="fixed inset-0 z-50 bg-white hidden flex-col items-center justify-between p-6 cursor-pointer select-none text-black" 
  id="torch-screen-overlay"
  title="Click anywhere or press ESC to turn off flashlight"
>
  <div class="flex items-center justify-between w-full font-mono-numbers text-xs font-bold tracking-widest text-zinc-800 uppercase">
    <span>FLASHLIGHT ACTIVE (MAX LUMENS)</span>
    <span>TAP ANYWHERE OR PRESS ESC TO EXIT</span>
  </div>

  <div class="flex flex-col items-center justify-center gap-2">
    <span class="material-symbols-outlined text-zinc-900 text-6xl">flashlight_on</span>
    <span class="text-xs font-mono-numbers tracking-widest text-zinc-700 font-bold uppercase">
      HIGH-INTENSITY WHITE LANTERN
    </span>
  </div>

  <div class="text-[10px] font-mono-numbers text-zinc-600 tracking-widest uppercase">
    EMERGENCY FIELD SIGNAL OVERLAY
  </div>
</div>

<!-- STROBE - Luz parpadeante -->
<div 
  class="fixed inset-0 pointer-events-none z-50 bg-white transition-opacity hidden" 
  id="strobe-screen-overlay" 
  style="opacity: 0;"
></div>

    <!-- Leaflet JS -->
<script
  src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"
  crossorigin=""
></script>

    <!-- Tu script principal -->
    <script src="../scripts/tactical-clock.js"></script>
  </body>
</html>